{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Harmonics: Full stack",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "API: dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/apps/api",
      "preLaunchTask": "Harmonics: Stop API port"
    },
    {
      "name": "Web: dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/apps/web",
      "preLaunchTask": "Harmonics: Stop Web port"
    }
  ]
}
