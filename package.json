{
  "name": "harmonics-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .vscode/start-dev.ps1",
    "build": "npm run build --workspace @harmonics/api && npm run build --workspace @harmonics/web",
    "lint": "npm run lint --workspace @harmonics/web",
    "prisma:generate": "npm run prisma:generate --workspace @harmonics/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @harmonics/api"
  },
  "devDependencies": {
    "supabase": "^2.105.0"
  }
}
