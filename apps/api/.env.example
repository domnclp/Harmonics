DATABASE_URL=postgresql://...supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Generate with: npx web-push generate-vapid-keys
# Without these the API still boots; the notification scheduler stays off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NOTIFICATIONS_ENABLED=true
# Set false on hosts that sleep between requests; an external scheduler then
# drives POST /api/notifications/tick instead of the in-process cron.
SCHEDULER_IN_PROCESS=true
# Shared secret for that endpoint. Unset keeps the endpoint closed (404).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCHEDULER_TICK_SECRET=
